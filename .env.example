GB_APP_ID=
GB_USER_ID=
GB_API_PASSWORD=

# Grafana Cloud Free observability (optional for local development).
# Copy this file to .env and fill the values only on your machine. Never commit .env.
# Release builds read the same values from GitHub Actions Secrets instead.
#
# Endpoint format: https://otlp-gateway-<region>.grafana.net/otlp/v1/metrics
EMMM_GRAFANA_OTLP_METRICS_ENDPOINT=
# Example format: Basic <base64(instance-id:metrics-write-token)>
EMMM_GRAFANA_OTLP_AUTHORIZATION=
# Faro collector URL supplied by Grafana Cloud.
VITE_GRAFANA_FARO_URL=
VITE_GRAFANA_FARO_API_KEY=
# Optional locally; GitHub releases use the tag automatically.
VITE_APP_VERSION=
