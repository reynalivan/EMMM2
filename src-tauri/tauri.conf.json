{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMMM",
  "version": "0.1.0",
  "identifier": "com.reynalivan.emmm",
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/reynalivan/EMMM/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3ODI2Mjg1MUMzREJCNTUKUldSVnV6MGNoV0tDbDZqOSt1WGRCMFNXdFV1bmhyRTVOZDVzV0FIVHBLc3BVT2wwZExmbHFYN1oK"
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EMMM",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0b0b0f"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "font-src": "'self' asset: http://asset.localhost data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "resources/": "" }
  }
}
