{
  "name": "emmm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": "10.24.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:tauri": "node scripts/tauri-dev-server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "native:prepare": "node scripts/tauri.mjs --prepare-only",
    "tauri": "node scripts/tauri.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "validate:observability": "node scripts/validate-observability-env.mjs",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "i18n:sync": "i18next-cli sync",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run wdio.conf.ts",
    "lint": "eslint .",
    "lint:arch": "eslint --config eslint.arch.config.js src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@grafana/faro-react": "^2.11.0",
    "@grafana/faro-web-sdk": "^2.11.0",
